# ---------------------------------------------------------------------------
# Contact form email delivery — Resend (https://resend.com)
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values:
#
#   cp .env.example .env.local
#
# 1. Create a free account at https://resend.com
# 2. Generate an API key at https://resend.com/api-keys
# 3. Verify a domain (or test first with onboarding@resend.dev — see below)

# API key used to send emails (required for the contact form).
RESEND_API_KEY=

# Verified sender address shown as the email's "From".
# Until you verify a domain with Resend, testing is limited to:
#   Ineza SmartGrid <onboarding@resend.dev>
RESEND_EMAIL_FROM=Ineza SmartGrid <onboarding@resend.dev>

# Inbox that receives contact form submissions.
# Leave empty to default to site.email (hello@inezasmartgrid.com).
CONTACT_EMAIL_TO=
